---
// S-03. Fasilitas dan cottage dikerjakan di US-06, US-08, dan US-09.
import DagoMenuNote from "../components/DagoMenuNote.astro";
import Gallery from "../components/Gallery.astro";
import HoursTable from "../components/HoursTable.astro";
import OutletIntro from "../components/OutletIntro.astro";
import OutletLocation from "../components/OutletLocation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteShell } from "../lib/content/getSiteShell";
import { getOutlet } from "../lib/content/siteShell";

const shell = await getSiteShell();
const outlet = getOutlet(shell, "dago");
---

<BaseLayout title={outlet.name}>
  <OutletIntro outlet={outlet} instagramUrl={shell.settings.instagramUrl} />
  <HoursTable outlet={outlet} />
  <DagoMenuNote outlet={outlet} settings={shell.settings} />
  <OutletLocation outlet={outlet} />
  <Gallery id="gallery" title="Galeri Dago" photos={outlet.gallery} />
</BaseLayout>
