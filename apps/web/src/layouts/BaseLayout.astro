---
// Kerangka semua halaman. WhatsAppButton, banner cookie, dan meta SEO menyusul
// bersama US-07, US-12, dan US-13.
import "@fontsource/anton/latin-400.css";
import "@fontsource/archivo/latin-400.css";
import "@fontsource/archivo/latin-700.css";
import "../styles/tokens.css";
import "../styles/base.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getSiteShell } from "../lib/content/getSiteShell";

interface Props {
  title: string;
  /** true bila halaman mengatur sendiri lebar tiap bagiannya, misalnya Beranda. */
  fullBleed?: boolean;
}

const { title, fullBleed = false } = Astro.props;
const shell = await getSiteShell();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader />
    <main class={fullBleed ? undefined : "container page"}>
      <slot />
    </main>
    <SiteFooter shell={shell} />
  </body>
</html>
