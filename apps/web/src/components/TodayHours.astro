---
// Jam hari ini (US-01.AC2). Dihitung di browser dalam WIB; tanpa JavaScript tabel mingguan yang
// tampil (kasus tepi 7.2).
import type { Outlet } from "../lib/content/types";
import WeeklyTable from "./WeeklyTable.astro";

interface Props {
  outlet: Outlet;
}

const { outlet } = Astro.props;
---

<div class="hours">
  <p data-today-hours={JSON.stringify(outlet.hours)} hidden></p>
  <div data-without-js>
    <WeeklyTable outlet={outlet} />
  </div>
</div>

<script>
  import type { DayHours } from "../lib/content/types";
  import { todayHoursText } from "../lib/formatHours";

  const REFRESH_MS = 15_000;

  function update(element: HTMLElement): void {
    const hours = JSON.parse(element.dataset.todayHours ?? "[]") as DayHours[];
    const text = todayHoursText(hours, new Date());
    element.textContent = text ?? "";
    element.hidden = text === null;
  }

  const elements = document.querySelectorAll<HTMLElement>("[data-today-hours]");
  const refresh = () => elements.forEach(update);

  document.querySelectorAll<HTMLElement>("[data-without-js]").forEach((element) => {
    element.hidden = true;
  });
  refresh();
  window.setInterval(refresh, REFRESH_MS);
  document.addEventListener("visibilitychange", refresh);
</script>

<style>
  .hours {
    width: 100%;
  }

  p {
    margin: 0;
    font-weight: 700;
  }
</style>
