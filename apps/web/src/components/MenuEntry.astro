---
// Satu item menu (US-04.AC3, US-04.AC4): kartu berfoto atau baris daftar (design system, ADR 0002).
import type { MenuItem } from "../lib/content/types";
import { formatPrice } from "../lib/formatPrice";
import { thumbSources } from "../lib/image";

interface Props {
  item: MenuItem;
  layout: "card" | "row";
}

const { item, layout } = Astro.props;
const photo = layout === "card" && item.imageUrl ? thumbSources(item.imageUrl) : null;
const labels = [item.isNew ? "New Menu" : null, item.badge].filter((label) => label !== null);
---

<li class:list={["entry", layout, { unavailable: !item.isAvailable }]} data-testid="menu-item">
  {layout === "card" && (
    <div class="photo">
      {photo && (
        <img
          src={photo.src}
          srcset={photo.srcset}
          sizes="(min-width: 640px) 220px, 45vw"
          alt=""
          loading="lazy"
        />
      )}
    </div>
  )}
  <div class="name">
    <h3>{item.name}</h3>
    {item.isSpicy && (
      <svg viewBox="0 0 24 24" role="img" aria-label="Pedas">
        <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
      </svg>
    )}
  </div>
  <p class="price" data-testid="menu-price">
    {formatPrice(item.priceIdr)}
  </p>
  {item.description && <p class="detail">{item.description}</p>}
  {item.options && <p class="detail">{item.options}</p>}
  {labels.map((label) => (
    <p class="label">{label}</p>
  ))}
  {!item.isAvailable && <p class="label off">Sedang tidak tersedia</p>}
</li>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-divider) solid var(--color-line);
  }

  .row .price {
    margin-left: auto;
  }

  .row .detail {
    order: 1;
    width: 100%;
  }

  .row .label {
    order: 2;
  }

  .photo {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    font-size: var(--text-base);
    text-transform: uppercase;
  }

  svg {
    flex: none;
    width: var(--icon-sm);
    height: var(--icon-sm);
    fill: none;
    stroke: currentcolor;
    stroke-width: var(--icon-stroke);
    stroke-linejoin: round;
  }

  .price {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .detail {
    color: var(--color-ink-muted);
  }

  .label {
    padding-inline: var(--space-2);
    border: var(--border-control) solid var(--color-ink);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .unavailable {
    color: var(--color-ink-muted);
  }

  .unavailable img {
    filter: grayscale(1);
  }

  .off {
    border-color: var(--color-line-strong);
    background: var(--color-bg);
  }
</style>
