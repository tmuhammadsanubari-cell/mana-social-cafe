---
// Tambahan dan upgrade berlabel, bukan item menu (ADR 0002).
import type { MenuAddOn } from "../lib/content/types";
import { formatPrice } from "../lib/formatPrice";

interface Props {
  addOns: MenuAddOn[];
}

const { addOns } = Astro.props;
---

<ul>
  {addOns.map((addOn) => (
    <li data-testid="menu-add-on">
      <span class="chip">{addOn.badge ?? "Add-On"}</span>
      <span class="name">{addOn.name}</span>
      <span class="price">{formatPrice(addOn.priceIdr)}</span>
      {addOn.note && <span class="note">{addOn.note}</span>}
    </li>
  ))}
</ul>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-3);
    border-bottom: var(--border-divider) solid var(--color-line);
  }

  .chip {
    padding-inline: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-on-dark);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .name {
    font-weight: 700;
    text-transform: uppercase;
  }

  .price {
    margin-left: auto;
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .note {
    width: 100%;
    color: var(--color-ink-muted);
  }
</style>
