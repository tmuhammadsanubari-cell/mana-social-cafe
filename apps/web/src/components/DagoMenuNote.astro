---
// Kasus tepi 7.4: menu Dago belum ada (Q-02), jadi menu Buah Batu tidak ditampilkan di sini.
import type { Outlet, SiteSettings } from "../lib/content/types";
import { generalMessage, whatsAppUrl } from "../lib/whatsapp";

interface Props {
  outlet: Outlet;
  settings: SiteSettings;
}

const { outlet, settings } = Astro.props;
const whatsappHref = settings.whatsappNumber
  ? whatsAppUrl(settings.whatsappNumber, generalMessage(outlet.name))
  : null;
---

<section id="menu-dago" class="note" aria-labelledby="menu-dago-title">
  <h2 id="menu-dago-title">Menu</h2>
  <p>Menu ManA Dago sedang disiapkan. Tanyakan menu hari ini lewat WhatsApp.</p>
  <div class="actions">
    {whatsappHref && (
      <a class="button button-dark" href={whatsappHref} target="_blank" rel="noopener">
        Tanya menu Dago
      </a>
    )}
    <a class="other" href="/menu">
      Lihat menu Buah Batu
    </a>
  </div>
</section>

<style>
  .note {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: var(--space-16);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  h2,
  p {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .other {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    border-radius: var(--radius-sm);
    font-weight: 700;
  }
</style>
