---
// Fasilitas utama di panel outlet (FR-02). Daftar lengkap di halaman outlet dikerjakan di US-06.
import type { Outlet } from "../lib/content/types";
import { facilityPlaceholder, mainFacilities } from "../lib/outletPanel";

interface Props {
  outlet: Outlet;
}

const { outlet } = Astro.props;
const facilities = mainFacilities(outlet.facilities);
---

{facilities.length > 0 ? (
  <ul aria-label="Fasilitas utama">
    {facilities.map((facility) => (
      <li>
        {/* Bentuk ikon dan teks membedakan ketersediaan, bukan warna (US-06.AC2). */}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          {facility.isAvailable ? (
            <path d="M20 6 9 17l-5-5" />
          ) : (
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM8 12h8" />
          )}
        </svg>
        <span>{facility.isAvailable ? facility.label : `${facility.label} (tidak tersedia)`}</span>
      </li>
    ))}
  </ul>
) : (
  <p>{facilityPlaceholder(outlet.slug)}</p>
)}

<style>
  ul {
    display: grid;
    gap: var(--space-2) var(--space-6);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  svg {
    flex: none;
    width: var(--icon-sm);
    height: var(--icon-sm);
    margin-top: var(--space-1);
    fill: none;
    stroke: currentcolor;
    stroke-width: var(--icon-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  p {
    margin: 0;
    color: var(--color-ink-muted);
  }

  @media (min-width: 1024px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
