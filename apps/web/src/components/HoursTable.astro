---
// Bagian "Jam buka" di halaman outlet (S-02, S-03).
import type { Outlet } from "../lib/content/types";
import WeeklyTable from "./WeeklyTable.astro";

interface Props {
  outlet: Outlet;
}

const { outlet } = Astro.props;
---

<section class="hours" aria-labelledby="hours-title">
  <div>
    <h2 id="hours-title">Jam buka</h2>
    <p>Semua jam dalam WIB.</p>
  </div>
  <WeeklyTable outlet={outlet} />
</section>

<style>
  .hours {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-16);
  }

  h2 {
    margin: 0 0 var(--space-2);
  }

  p {
    margin: 0;
    color: var(--color-ink-muted);
  }

  @media (min-width: 1024px) {
    .hours {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-12);
    }
  }
</style>
