# Salin ke .env lalu isi. Daftar lengkap di PRD 13.5.
# Variabel PUBLIC_* ikut terkirim ke browser, jadi jangan taruh rahasia di sini.

PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=staging
PUBLIC_GA4_MEASUREMENT_ID=

# preview: konten contoh tampil berlabel "Data contoh".
# production: build gagal bila masih ada is_placeholder = true (BR-06).
BUILD_ENV=preview

# Kosongkan untuk membaca Sanity. "fixture" memakai data uji tetap (E2E dan CI, ADR 0007);
# ditolak bila BUILD_ENV=production.
CONTENT_SOURCE=

# SANITY_DEPLOY_TOKEN hanya disimpan di GitHub Secrets dan variabel hosting, tidak di file ini.
