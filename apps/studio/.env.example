# Salin ke .env lalu isi. Variabel SANITY_STUDIO_* ikut masuk ke bundle Studio.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=staging

# ID pengguna Sanity (bukan email) yang boleh mengubah Pengaturan Situs dan menghapus Outlet.
# Pisahkan dengan koma. Lihat ID lewat: npx sanity users list. Alasan: ADR 0006.
SANITY_STUDIO_SITE_ADMIN_IDS=
