{
  "name": "mana-social-cafe",
  "private": true,
  "type": "module",
  "description": "Website statis ManA Social Cafe (Astro + Sanity)",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "apps/web",
    "apps/studio"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:studio": "npm run dev -w apps/studio",
    "build": "npm run build -w apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "seed": "npm run seed -w apps/studio",
    "seed:replace": "npm run seed:replace -w apps/studio",
    "test:e2e": "npm run test:e2e -w apps/web --"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-boundaries": "^7.4.5",
    "globals": "^17.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    }
  }
}
